GEMINI_API_KEY=your_gemini_api_key
# Optional: override the default model used by /api/generate.
# GEMINI_MODEL=your_model_id

# Clerk app keys (from your Clerk dashboard).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Server-only Firebase service account credentials for saved lists.
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="your_service_account_private_key"

# Optional: use an existing Clerk Firebase token template instead of server credentials.
# NEXT_PUBLIC_CLERK_FIREBASE_TEMPLATE=integration_firebase
